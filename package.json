{
  "name": "litematica-preview",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "scripts": {
    "apt:publish": "vpx scripts/apt-publish.ts",
    "build:linux": "pnpm install --frozen-lockfile && vpx scripts/build-linux.ts",
    "build:linux:apt": "pnpm install --frozen-lockfile && vpx scripts/build-linux.ts --apt",
    "build:win": "pnpm install --frozen-lockfile && vpx scripts/build.ts",
    "build": "tsc --noEmit && vp build",
    "bump": "vpx scripts/bump-version.ts",
    "check:host": "vpx scripts/cargo.ts check --manifest-path src-tauri/Cargo.toml --all-targets --locked",
    "check": "pnpm run format:check && pnpm run lint && pnpm run format:rust && pnpm run build && pnpm run test && pnpm run test:host",
    "checksums": "vpx scripts/checksums.ts",
    "dev": "vp dev --host 127.0.0.1",
    "doctor": "react-doctor",
    "format:check": "vp fmt --check",
    "format:rust:write": "cargo fmt --all",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "format": "vp fmt",
    "lint": "vp lint",
    "preview": "vp preview --host 127.0.0.1",
    "pressure:host": "vpx scripts/cargo.ts run --release --locked --manifest-path src-tauri/Cargo.toml --bin pressure --",
    "record-memory": "vpx scripts/record-memory.ts",
    "resolve:host": "vpx scripts/cargo.ts update --manifest-path src-tauri/Cargo.toml -p litematica-preview",
    "tauri:dev": "tauri dev",
    "tauri": "tauri",
    "test:host": "vpx scripts/cargo.ts test --manifest-path src-tauri/Cargo.toml --locked",
    "test": "vp test run",
    "version:bump": "vpx scripts/bump-version.ts",
    "version:check": "vpx scripts/bump-version.ts --check",
    "prepare": "vp config"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.75.1",
    "@fluentui/react-icons": "^2.0.345",
    "@tauri-apps/api": "^2.12.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fflate": "^0.8.3",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.18.0"
}
