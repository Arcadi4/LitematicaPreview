<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../Assets/app.ico</ApplicationIcon>
    <AssemblyName>LitematicaPreview</AssemblyName>
    <Version>0.1.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenTK.GLControl" Version="4.0.2" />
    <Content Include="../Assets/pack.zip" Link="Assets/pack.zip" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Assets/icon.png" Link="Assets/icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Fixtures/Demos/*" Link="Demos/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../LICENSE;../NOTICE" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../ThirdParty/*" Link="ThirdParty/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Native/target/x86_64-pc-windows-msvc/release/litematica_preview_native.dll"
             Link="litematica_preview_native.dll" CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('../Native/target/x86_64-pc-windows-msvc/release/litematica_preview_native.dll')" />
  </ItemGroup>
  <Target Name="RequireNativeForPublish" BeforeTargets="Publish">
    <Error Condition="!Exists('../Native/target/x86_64-pc-windows-msvc/release/litematica_preview_native.dll')"
           Text="Build the Windows Rust DLL first with scripts/build.ps1. A C#-only build is not runnable." />
  </Target>
</Project>
