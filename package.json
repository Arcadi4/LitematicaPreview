{
  "name": "litematica-preview",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:win": "pnpm install --frozen-lockfile && tsx scripts/build.ts",
    "build": "tsc --noEmit && vp build",
    "bump": "tsx scripts/bump-version.ts",
    "check:host": "tsx scripts/cargo.ts check --manifest-path src-tauri/Cargo.toml --all-targets --locked",
    "check": "pnpm run format:check && pnpm run lint && pnpm run format:rust && pnpm run build && pnpm run test && pnpm run test:host",
    "checksums": "tsx scripts/checksums.ts",
    "dev": "vp dev --host 127.0.0.1",
    "doctor": "react-doctor",
    "format:check": "vp fmt --check",
    "format:rust:write": "cargo fmt --all",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "format": "vp fmt",
    "lint": "vp lint",
    "preview": "vp preview --host 127.0.0.1",
    "record-memory": "tsx scripts/record-memory.ts",
    "resolve:host": "tsx scripts/cargo.ts update --manifest-path src-tauri/Cargo.toml -p litematica-preview",
    "tauri:dev": "tauri dev",
    "tauri": "tauri",
    "test:host": "tsx scripts/cargo.ts test --manifest-path src-tauri/Cargo.toml --locked",
    "test": "vp test run",
    "version:bump": "tsx scripts/bump-version.ts",
    "version:check": "tsx scripts/bump-version.ts --check"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.343",
    "@tauri-apps/api": "^2.12.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.2",
    "react-doctor": "^0.9.17",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.7.0",
      "onFail": "warn"
    }
  }
}
